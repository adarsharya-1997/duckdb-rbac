# name: test/sql/rbac/ddl_whitespace.test
# description: DDL parsing with whitespace/newlines (supported with token-based parser)
# group: [rbac]

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE ws_table (id INTEGER, name VARCHAR);

statement ok
CREATE ROLE ws_role;

# =============================================================================
# Whitespace-heavy parsing (token-based parser handles newlines correctly)
# =============================================================================

# Multi-line CREATE ROLE
query I
CREATE ROLE
    ws_role_2
;
----
Role created: ws_role_2

# Multi-line GRANT SELECT
query I
GRANT
    SELECT
ON
    ws_table
TO
    ws_role
;
----
Table privilege granted: SELECT ON ws_table TO ws_role

# Multi-line column list
query I
GRANT SELECT
(
    id,
    name
)
ON ws_table TO ws_role_2
;
----
Column privileges granted on ws_table TO ws_role_2

# Multi-line CREATE ROW POLICY
query I
CREATE ROW POLICY
    ws_policy
ON
    ws_table
FOR SELECT
USING
(
    id > 0
)
TO
    ws_role
;
----
Row policy created: ws_policy ON ws_table

# Multi-line DROP ROW POLICY
query I
DROP ROW POLICY
    ws_policy
ON
    ws_table
;
----
Row policy dropped: ws_policy ON ws_table

# =============================================================================
# Cleanup
# =============================================================================

statement ok
REVOKE SELECT ON ws_table FROM ws_role;

statement ok
REVOKE SELECT (id, name) ON ws_table FROM ws_role_2;

statement ok
DROP TABLE ws_table;

statement ok
DROP ROLE ws_role;

statement ok
DROP ROLE ws_role_2;
