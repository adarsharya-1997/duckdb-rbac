# name: test/sql/rbac/01_roles.test
# description: Test RBAC DDL statements - roles, grants, policies
# group: [rbac]

require quack

# ===== CREATE ROLE / DROP ROLE =====

# Create a role
query I
CREATE ROLE analyst
----
Role created: analyst

# Verify role exists in system table
query I
SELECT role_name FROM duckdb_roles WHERE role_name = 'analyst'
----
analyst

# Creating same role again should fail
statement error
CREATE ROLE analyst
----
already exists

# Create another role
query I
CREATE ROLE reader
----
Role created: reader

# Drop a role
query I
DROP ROLE reader
----
Role dropped: reader

# Verify role is gone
query I
SELECT COUNT(*) FROM duckdb_roles WHERE role_name = 'reader'
----
0

# Dropping non-existent role should fail
statement error
DROP ROLE nonexistent
----
does not exist

# ===== GRANT/REVOKE ROLE MEMBERSHIP =====

# Create roles for membership test
query I
CREATE ROLE team_lead
----
Role created: team_lead

# Grant role to another role
query I
GRANT analyst TO team_lead
----
Role granted: analyst TO team_lead

# Verify membership in system table
query II
SELECT role_name, member FROM duckdb_role_members WHERE role_name = 'analyst' AND member = 'team_lead'
----
analyst	team_lead

# Grant to non-existent role should fail
statement error
GRANT analyst TO nonexistent
----
does not exist

# Revoke role membership
query I
REVOKE analyst FROM team_lead
----
Role revoked: analyst FROM team_lead

# Verify membership removed
query I
SELECT COUNT(*) FROM duckdb_role_members WHERE role_name = 'analyst' AND member = 'team_lead'
----
0

# ===== GRANT/REVOKE TABLE PRIVILEGES =====

# Create a test table
statement ok
CREATE TABLE orders (id INT, customer VARCHAR, amount DECIMAL)

# Grant SELECT on table
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# Verify grant in system table
query III
SELECT grantee, table_name, privilege_type FROM duckdb_table_privileges WHERE table_name = 'orders'
----
analyst	orders	SELECT

# Granting same privilege again should succeed (idempotent)
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# Grant to non-existent table should fail
statement error
GRANT SELECT ON nonexistent_table TO analyst
----
does not exist

# Revoke table privilege
query I
REVOKE SELECT ON orders FROM analyst
----
Table privilege revoked: SELECT ON orders FROM analyst

# Verify privilege removed
query I
SELECT COUNT(*) FROM duckdb_table_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
0

# ===== GRANT/REVOKE COLUMN PRIVILEGES =====

# Grant SELECT on specific columns
query I
GRANT SELECT (id, customer) ON orders TO analyst
----
Column privileges granted on orders TO analyst

# Verify column grants in system table
query I
SELECT COUNT(*) FROM duckdb_column_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
2

query III
SELECT grantee, column_name, privilege_type FROM duckdb_column_privileges WHERE table_name = 'orders' ORDER BY column_name
----
analyst	customer	SELECT
analyst	id	SELECT

# Grant on non-existent column should fail
statement error
GRANT SELECT (nonexistent_col) ON orders TO analyst
----
does not exist

# Revoke column privileges
query I
REVOKE SELECT (id) ON orders FROM analyst
----
Column privileges revoked on orders FROM analyst

# Verify one column privilege removed
query I
SELECT COUNT(*) FROM duckdb_column_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
1

# ===== CREATE/DROP ROW POLICY =====

# Create a row policy
query I
CREATE ROW POLICY regional_filter ON orders FOR SELECT USING (amount > 100) TO analyst
----
Row policy created: regional_filter ON orders

# Verify policy in system table
query IIII
SELECT policy_name, table_name, filter_expression, grantee FROM duckdb_row_policies WHERE policy_name = 'regional_filter'
----
regional_filter	orders	amount > 100	analyst

# Creating same policy again should fail
statement error
CREATE ROW POLICY regional_filter ON orders FOR SELECT USING (amount > 0) TO analyst
----
already exists

# Create policy for non-existent table should fail
statement error
CREATE ROW POLICY test_policy ON nonexistent_table FOR SELECT USING (id > 0) TO analyst
----
does not exist

# Drop row policy
query I
DROP ROW POLICY regional_filter ON orders
----
Row policy dropped: regional_filter ON orders

# Verify policy removed
query I
SELECT COUNT(*) FROM duckdb_row_policies WHERE policy_name = 'regional_filter'
----
0

# ===== FR-3: Cannot drop role with existing grants =====

# Re-grant privilege to analyst
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# T-01-07: Trying to drop analyst should fail (has table grants)
statement error
DROP ROLE analyst
----
existing grants

# Clean up grant first
query I
REVOKE SELECT ON orders FROM analyst
----
Table privilege revoked: SELECT ON orders FROM analyst

# Also clean up remaining column privilege
query I
REVOKE SELECT (customer) ON orders FROM analyst
----
Column privileges revoked on orders FROM analyst

# Now drop should succeed
query I
DROP ROLE analyst
----
Role dropped: analyst

# ===== T-01-08: Cannot drop role with column grants =====

query I
CREATE ROLE col_role
----
Role created: col_role

query I
GRANT SELECT (id, customer) ON orders TO col_role
----
Column privileges granted on orders TO col_role

statement error
DROP ROLE col_role
----
existing grants

query I
REVOKE SELECT (id, customer) ON orders FROM col_role
----
Column privileges revoked on orders FROM col_role

query I
DROP ROLE col_role
----
Role dropped: col_role

# ===== T-01-09: Cannot drop role with row policies =====

query I
CREATE ROLE policy_role
----
Role created: policy_role

query I
CREATE ROW POLICY test_policy ON orders FOR SELECT USING (amount > 0) TO policy_role
----
Row policy created: test_policy ON orders

statement error
DROP ROLE policy_role
----
existing grants

query I
DROP ROW POLICY test_policy ON orders
----
Row policy dropped: test_policy ON orders

query I
DROP ROLE policy_role
----
Role dropped: policy_role

# ===== T-01-10: Cannot drop role that is member of another =====

query I
CREATE ROLE parent_role
----
Role created: parent_role

query I
CREATE ROLE member_role
----
Role created: member_role

query I
GRANT parent_role TO member_role
----
Role granted: parent_role TO member_role

# Cannot drop member_role (it has membership as member)
statement error
DROP ROLE member_role
----
existing grants

# Cannot drop parent_role (it has membership as the role being granted)
statement error
DROP ROLE parent_role
----
existing grants

query I
REVOKE parent_role FROM member_role
----
Role revoked: parent_role FROM member_role

query I
DROP ROLE member_role
----
Role dropped: member_role

query I
DROP ROLE parent_role
----
Role dropped: parent_role

# ===== T-01-13: Grant non-existent role to member =====

query I
CREATE ROLE existing_member
----
Role created: existing_member

statement error
GRANT nonexistent_role TO existing_member
----
does not exist

query I
DROP ROLE existing_member
----
Role dropped: existing_member

# ===== T-01-14: Grant same membership twice (idempotent) =====

query I
CREATE ROLE role_a
----
Role created: role_a

query I
CREATE ROLE role_b
----
Role created: role_b

query I
GRANT role_a TO role_b
----
Role granted: role_a TO role_b

# Grant same membership again - should be idempotent (succeed without error)
query I
GRANT role_a TO role_b
----
Role granted: role_a TO role_b

# Verify only one membership entry exists
query I
SELECT COUNT(*) FROM duckdb_role_members WHERE role_name = 'role_a' AND member = 'role_b'
----
1

query I
REVOKE role_a FROM role_b
----
Role revoked: role_a FROM role_b

query I
DROP ROLE role_b
----
Role dropped: role_b

query I
DROP ROLE role_a
----
Role dropped: role_a

# ===== T-01-16: Revoke membership that doesn't exist (idempotent) =====

query I
CREATE ROLE role_x
----
Role created: role_x

query I
CREATE ROLE role_y
----
Role created: role_y

# No membership exists between role_x and role_y
# Revoke should succeed (idempotent - no error even if nothing to revoke)
query I
REVOKE role_x FROM role_y
----
Role revoked: role_x FROM role_y

query I
DROP ROLE role_y
----
Role dropped: role_y

query I
DROP ROLE role_x
----
Role dropped: role_x

# Clean up
query I
DROP ROLE team_lead
----
Role dropped: team_lead

statement ok
DROP TABLE orders
