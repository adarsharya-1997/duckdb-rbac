# name: test/sql/rbac/20_set_ops_except_union.test
# description: Row policy enforcement with EXCEPT and UNION (distinct)
# group: [rbac]

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE items (
    id INTEGER,
    region VARCHAR
);

statement ok
INSERT INTO items VALUES
    (1, 'US'),
    (2, 'EU'),
    (3, 'US'),
    (4, 'US');

statement ok
CREATE ROLE items_role;

statement ok
GRANT SELECT ON items TO items_role;

statement ok
CREATE ROW POLICY us_only ON items FOR SELECT USING (region = 'US') TO items_role;

statement ok
SELECT * FROM rbac_set_identity('setops2_user', ['items_role'], false);

# =============================================================================
# UNION (distinct) should see filtered rows only (distinct removes duplicates)
# =============================================================================

query I
SELECT COUNT(*) FROM (
    SELECT id FROM items
    UNION
    SELECT 3
);
----
3

# =============================================================================
# EXCEPT should operate on filtered rows only
# =============================================================================

query I
SELECT COUNT(*) FROM (
    SELECT id FROM items
    EXCEPT
    SELECT * FROM (VALUES (1)) t(id)
);
----
2

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY us_only ON items;

statement ok
REVOKE SELECT ON items FROM items_role;

statement ok
DROP TABLE items;

statement ok
DROP ROLE items_role;
