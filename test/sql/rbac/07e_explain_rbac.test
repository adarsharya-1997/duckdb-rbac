# name: test/sql/rbac/07e_explain_rbac.test
# description: Test EXPLAIN behavior with RBAC enforcement
# group: [rbac]
# requirements: T-08-14, T-08-15 from TEST.md

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE allowed_table (id INTEGER, data VARCHAR);

statement ok
INSERT INTO allowed_table VALUES (1, 'test'), (2, 'data');

statement ok
CREATE TABLE forbidden_table (id INTEGER, secret VARCHAR);

statement ok
INSERT INTO forbidden_table VALUES (1, 'classified');

statement ok
CREATE ROLE limited_user;

statement ok
GRANT SELECT ON allowed_table TO limited_user;

# No grant on forbidden_table

# =============================================================================
# Set non-superuser identity
# =============================================================================

statement ok
SELECT * FROM rbac_set_identity('test_user', ['limited_user'], false);

# =============================================================================
# T-08-14: EXPLAIN on query user can run - should succeed
# =============================================================================

# Simple EXPLAIN should work
statement ok
EXPLAIN SELECT * FROM allowed_table;

# EXPLAIN ANALYZE should also work
statement ok
EXPLAIN ANALYZE SELECT * FROM allowed_table;

# EXPLAIN with filter
statement ok
EXPLAIN SELECT id FROM allowed_table WHERE id > 1;

# EXPLAIN with aggregation
statement ok
EXPLAIN SELECT COUNT(*) FROM allowed_table;

# =============================================================================
# T-08-15: EXPLAIN on query user cannot run - should fail
# =============================================================================

# EXPLAIN on forbidden table should fail with permission error
statement error
EXPLAIN SELECT * FROM forbidden_table;
----
lacks SELECT privilege on table

# EXPLAIN ANALYZE on forbidden table should also fail
statement error
EXPLAIN ANALYZE SELECT * FROM forbidden_table;
----
lacks SELECT privilege on table

# EXPLAIN on JOIN with forbidden table should fail
statement error
EXPLAIN SELECT a.id FROM allowed_table a JOIN forbidden_table f ON a.id = f.id;
----
lacks SELECT privilege on table

# =============================================================================
# Cleanup
# =============================================================================

statement ok
REVOKE SELECT ON allowed_table FROM limited_user;

statement ok
DROP TABLE allowed_table;

statement ok
DROP TABLE forbidden_table;

statement ok
DROP ROLE limited_user;
