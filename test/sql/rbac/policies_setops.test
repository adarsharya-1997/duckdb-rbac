# name: test/sql/rbac/14_set_ops_window_policies.test
# description: Row policy enforcement with set operations and window functions
# group: [rbac]

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE orders (
    id INTEGER,
    region VARCHAR
);

statement ok
INSERT INTO orders VALUES
    (1, 'US'),
    (2, 'EU'),
    (3, 'US');

statement ok
CREATE ROLE sales_role;

statement ok
GRANT SELECT ON orders TO sales_role;

statement ok
CREATE ROW POLICY us_only ON orders FOR SELECT USING (region = 'US') TO sales_role;

# =============================================================================
# Set identity (non-superuser)
# =============================================================================

statement ok
SELECT * FROM rbac_set_identity('setops_user', ['sales_role'], false);

# =============================================================================
# Set operations should see filtered rows only
# =============================================================================

query I
SELECT COUNT(*) FROM (
    SELECT id FROM orders
    UNION ALL
    SELECT 99
);
----
3

query I
SELECT COUNT(*) FROM (
    SELECT id FROM orders
    INTERSECT
    SELECT * FROM (VALUES (1), (2)) t(id)
);
----
1

# UNION (distinct) should see filtered rows only (distinct removes duplicates)
query I
SELECT COUNT(*) FROM (
    SELECT id FROM orders
    UNION
    SELECT 3
);
----
2

# EXCEPT should operate on filtered rows only
query I
SELECT COUNT(*) FROM (
    SELECT id FROM orders
    EXCEPT
    SELECT * FROM (VALUES (1)) t(id)
);
----
1

# =============================================================================
# Window functions should operate on filtered rows
# =============================================================================

query TT
SELECT id, row_number() OVER (ORDER BY id) AS rn FROM orders ORDER BY id;
----
1	1
3	2

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY us_only ON orders;

statement ok
REVOKE SELECT ON orders FROM sales_role;

statement ok
DROP TABLE orders;

statement ok
DROP ROLE sales_role;
