# name: test/sql/rbac/05_enforcement.test
# description: Test superuser bypass and setup verification for RBAC enforcement
# group: [rbac]
# requirements: FR-21 (Superuser Bypass)
#
# NOTE: Non-superuser enforcement tests are in:
#   - 05b_enforcement_table.test (table-level access)
#   - 05c_enforcement_column.test (column-level access)
#   - 05d_enforcement_inherited.test (inherited role permissions)

require quack

# =============================================================================
# Setup - Create test data (runs as superuser by default)
# =============================================================================

statement ok
CREATE TABLE orders (
    id INTEGER,
    customer VARCHAR,
    amount DECIMAL,
    region VARCHAR,
    secret_notes VARCHAR
);

statement ok
INSERT INTO orders VALUES 
    (1, 'Alice', 100.00, 'US', 'Internal note 1'),
    (2, 'Bob', 200.00, 'EU', 'Internal note 2'),
    (3, 'Charlie', 150.00, 'US', 'Internal note 3');

statement ok
CREATE TABLE secret_table (
    id INTEGER,
    data VARCHAR
);

statement ok
INSERT INTO secret_table VALUES (1, 'Top Secret');

# Create roles and grants for verification
statement ok
CREATE ROLE analyst;

statement ok
CREATE ROLE us_analyst;

statement ok
GRANT SELECT ON orders TO analyst;

statement ok
GRANT SELECT ON orders TO us_analyst;

statement ok
CREATE ROW POLICY us_only ON orders FOR SELECT USING (region = 'US') TO us_analyst;

# =============================================================================
# 6.4 Superuser Bypass (FR-21)
# By default (no identity set), we operate as superuser
# =============================================================================

# Verify we are superuser
query I
SELECT rbac_is_superuser();
----
true

# T-05-05: Superuser queries table with no grants
# As superuser, we can query secret_table even though no role has SELECT on it
query I
SELECT COUNT(*) FROM secret_table;
----
1

query IT
SELECT * FROM secret_table;
----
1	Top Secret

# T-05-06: Superuser queries forbidden column
# The secret_notes column has no grants but superuser can access it
query I
SELECT COUNT(secret_notes) FROM orders;
----
3

query T
SELECT secret_notes FROM orders WHERE id = 1;
----
Internal note 1

# T-05-07: Superuser queries table with row policy (no filter applied)
# us_analyst has row policy to see only US rows, but superuser sees all
query I
SELECT COUNT(*) FROM orders;
----
3

query I
SELECT COUNT(*) FROM orders WHERE region = 'EU';
----
1

# T-05-08: Default identity (no identity set) treated as superuser
# This is already verified above - superuser can access everything

# =============================================================================
# Verify grant setup is correct (for use by other tests)
# =============================================================================

# Verify analyst has table-level SELECT on orders
query I
SELECT COUNT(*) FROM duckdb_table_privileges 
WHERE grantee = 'analyst' AND table_name = 'orders';
----
1

# Verify analyst does NOT have access to secret_table
query I
SELECT COUNT(*) FROM duckdb_table_privileges 
WHERE grantee = 'analyst' AND table_name = 'secret_table';
----
0

# Verify us_analyst has row policy
query I
SELECT COUNT(*) FROM duckdb_row_policies
WHERE grantee = 'us_analyst' AND table_name = 'orders';
----
1

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY us_only ON orders;

statement ok
REVOKE SELECT ON orders FROM analyst;

statement ok
REVOKE SELECT ON orders FROM us_analyst;

statement ok
DROP TABLE orders;

statement ok
DROP TABLE secret_table;

statement ok
DROP ROLE analyst;

statement ok
DROP ROLE us_analyst;
