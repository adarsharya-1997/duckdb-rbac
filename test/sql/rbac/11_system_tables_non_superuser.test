# name: test/sql/rbac/11_system_tables_non_superuser.test
# description: Non-superuser can read RBAC system tables
# group: [rbac]

require quack

# =============================================================================
# Setup: Create roles, grants, and a policy
# =============================================================================

statement ok
CREATE ROLE r1;

statement ok
CREATE ROLE r2;

statement ok
GRANT r1 TO r2;

statement ok
CREATE TABLE data_table (id INTEGER, region VARCHAR);

statement ok
INSERT INTO data_table VALUES (1, 'US'), (2, 'EU');

statement ok
GRANT SELECT ON data_table TO r1;

statement ok
GRANT SELECT (id) ON data_table TO r2;

statement ok
CREATE ROW POLICY region_us ON data_table FOR SELECT USING (region = 'US') TO r2;

# =============================================================================
# Set non-superuser identity with no roles
# =============================================================================

statement ok
SELECT * FROM rbac_set_identity('readonly_user', []::VARCHAR[], false);

# =============================================================================
# Test: RBAC system tables are readable by any user
# =============================================================================

query I
SELECT COUNT(*) >= 2 FROM duckdb_roles;
----
true

query I
SELECT COUNT(*) >= 1 FROM duckdb_role_members;
----
true

query I
SELECT COUNT(*) >= 1 FROM duckdb_table_privileges;
----
true

query I
SELECT COUNT(*) >= 1 FROM duckdb_column_privileges;
----
true

query I
SELECT COUNT(*) >= 1 FROM duckdb_row_policies;
----
true

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY region_us ON data_table;

statement ok
REVOKE SELECT ON data_table FROM r1;

statement ok
REVOKE SELECT (id) ON data_table FROM r2;

statement ok
DROP TABLE data_table;

statement ok
REVOKE r1 FROM r2;

statement ok
DROP ROLE r2;

statement ok
DROP ROLE r1;
