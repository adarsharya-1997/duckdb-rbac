# name: test/sql/rbac/08_error_messages.test
# description: Test RBAC error messages are clear and helpful
# group: [rbac]
# requirements: US-4, NFR-2

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE ROLE analyst;

statement ok
CREATE TABLE orders (id INTEGER, amount DECIMAL);

# =============================================================================
# Role Errors
# =============================================================================

# Role already exists
statement error
CREATE ROLE analyst;
----
Role 'analyst' already exists

# Role does not exist
statement error
DROP ROLE nonexistent;
----
Role 'nonexistent' does not exist

# Role does not exist for grant
statement error
GRANT SELECT ON orders TO nonexistent;
----
Role 'nonexistent' does not exist

# Role does not exist for membership
statement error
GRANT analyst TO nonexistent;
----
Role 'nonexistent' does not exist

statement error
GRANT nonexistent TO analyst;
----
Role 'nonexistent' does not exist

# =============================================================================
# Table Errors
# =============================================================================

# Table does not exist for grant
statement error
GRANT SELECT ON nonexistent TO analyst;
----
Table 'main.nonexistent' does not exist

# =============================================================================
# Column Errors
# =============================================================================

# Column does not exist
statement error
GRANT SELECT (nonexistent_col) ON orders TO analyst;
----
Column 'nonexistent_col' does not exist

# =============================================================================
# Policy Errors
# =============================================================================

# Policy already exists
statement ok
CREATE ROW POLICY test_policy ON orders FOR SELECT USING (amount > 0) TO analyst;

statement error
CREATE ROW POLICY test_policy ON orders FOR SELECT USING (amount > 0) TO analyst;
----
Row policy 'test_policy' already exists

# Policy on nonexistent table
statement error
CREATE ROW POLICY bad ON nonexistent FOR SELECT USING (x > 0) TO analyst;
----
Table 'main.nonexistent' does not exist

# Policy for nonexistent role
statement error
CREATE ROW POLICY bad ON orders FOR SELECT USING (amount > 0) TO nonexistent;
----
Role 'nonexistent' does not exist

# Policy with invalid column in expression
statement error
CREATE ROW POLICY bad ON orders FOR SELECT USING (nonexistent_col > 0) TO analyst;
----
Column 'nonexistent_col' does not exist

# Drop nonexistent policy
statement error
DROP ROW POLICY nonexistent ON orders;
----
Row policy 'nonexistent' does not exist

# =============================================================================
# Drop Role with Dependencies
# =============================================================================

# Cannot drop role with grants
statement ok
GRANT SELECT ON orders TO analyst;

statement error
DROP ROLE analyst;
----
Cannot drop role 'analyst': role has existing grants

# =============================================================================
# T-06-06, T-06-07, T-06-08: Permission denied errors include context
# =============================================================================

# Setup for permission denial tests
statement ok
CREATE TABLE secret_data (id INTEGER, value VARCHAR, classified VARCHAR);

statement ok
CREATE ROLE test_user_role;

# Grant limited access
statement ok
GRANT SELECT (id, value) ON secret_data TO test_user_role;

# Set identity as non-superuser
statement ok
SELECT * FROM rbac_set_identity('alice_test', ['test_user_role'], false);

# T-06-06: Permission denied error includes table name
statement error
SELECT * FROM orders;
----
lacks SELECT privilege on table 'main.orders'

# T-06-07: Permission denied error includes column name
statement error
SELECT classified FROM secret_data;
----
lacks SELECT privilege on column 'classified'

# T-06-08: Permission denied error includes user name
# The error message should reference the user
statement error
SELECT * FROM orders;
----
User 'alice_test'

# Column error should also include user name
statement error
SELECT classified FROM secret_data;
----
User 'alice_test'

# =============================================================================
# Cleanup
# =============================================================================

statement ok
REVOKE SELECT (id, value) ON secret_data FROM test_user_role;

statement ok
DROP TABLE secret_data;

statement ok
DROP ROW POLICY test_policy ON orders;

statement ok
REVOKE SELECT ON orders FROM analyst;

statement ok
DROP TABLE orders;

statement ok
DROP ROLE analyst;

statement ok
DROP ROLE test_user_role;

