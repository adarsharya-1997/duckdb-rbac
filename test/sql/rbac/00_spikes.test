# name: test/sql/rbac/00_spikes.test
# description: Validation spikes for RBAC extension hooks
# group: [rbac]

require quack

# ===== Spike 0.4: Session state =====

# Test rbac_current_user() returns default value
query I
SELECT rbac_current_user()
----
default_user

# Test rbac_is_superuser() returns true by default
query I
SELECT rbac_is_superuser()
----
true

# Test rbac_current_roles() returns empty list by default
query I
SELECT rbac_current_roles()
----
[]

# ===== Spike 0.2: Optimizer throws on blocked table =====

# Create tables for testing
statement ok
CREATE TABLE allowed (id INT)

statement ok
CREATE TABLE blocked (id INT)

# Allowed table should work fine
statement ok
SELECT * FROM allowed

# Blocked table should throw PermissionException
statement error
SELECT * FROM blocked
----
Access denied to table 'blocked'

# ===== Spike 0.3: Filter injection =====

# Unfiltered table should return all rows (no filter injected)
statement ok
CREATE TABLE unfiltered_table (id INT)

statement ok
INSERT INTO unfiltered_table VALUES (-1), (0), (1), (2)

query I
SELECT * FROM unfiltered_table ORDER BY id
----
-1
0
1
2

statement ok
CREATE TABLE filtered_table (id INT)

statement ok
INSERT INTO filtered_table VALUES (-1), (0), (1), (2)

# Query should automatically filter to only id > 0
query I
SELECT * FROM filtered_table ORDER BY id
----
1
2

# ===== Spike 0.1: Parser catches CREATE ROLE =====

# CREATE ROLE should be intercepted by our parser extension
query I
CREATE ROLE test_role
----
Role created: test_role

# DROP ROLE should also work
query I
DROP ROLE test_role
----
Role dropped: test_role

# ===== Spike 0.5: Expression binding =====

# Basic case: integer comparison with parsed expression "id > 0"
statement ok
CREATE TABLE policy_test (id INT, name VARCHAR)

statement ok
INSERT INTO policy_test VALUES (1, 'visible'), (0, 'hidden'), (2, 'also_visible')

query IT
SELECT * FROM policy_test ORDER BY id
----
1	visible
2	also_visible

# Error case: referencing non-existent column should fail
statement ok
CREATE TABLE policy_bad_column (id INT, value INT)

statement error
SELECT * FROM policy_bad_column
----
Column 'nonexistent_column' not found

# String equality filter: status = 'active'
statement ok
CREATE TABLE policy_string_filter (id INT, status VARCHAR)

statement ok
INSERT INTO policy_string_filter VALUES (1, 'active'), (2, 'inactive'), (3, 'active')

query IT
SELECT * FROM policy_string_filter ORDER BY id
----
1	active
3	active
