# name: test/sql/rbac/00_spikes.test
# description: Validation spikes for RBAC extension hooks
# group: [rbac]

require quack

# ===== Spike 0.4: Session state =====

# Test rbac_current_user() returns default value
query I
SELECT rbac_current_user()
----
default_user

# Test rbac_is_superuser() returns true by default
query I
SELECT rbac_is_superuser()
----
true

# Test rbac_current_roles() returns empty list by default
query I
SELECT rbac_current_roles()
----
[]

# ===== Spike 0.2: Optimizer throws on blocked table =====

# Create tables for testing
statement ok
CREATE TABLE allowed (id INT)

statement ok
CREATE TABLE blocked (id INT)

# Allowed table should work fine
statement ok
SELECT * FROM allowed

# Blocked table should throw PermissionException
statement error
SELECT * FROM blocked
----
Access denied to table 'blocked'

# ===== Spike 0.3: Filter injection =====

# Unfiltered table should return all rows (no filter injected)
statement ok
CREATE TABLE unfiltered_table (id INT)

statement ok
INSERT INTO unfiltered_table VALUES (-1), (0), (1), (2)

query I
SELECT * FROM unfiltered_table ORDER BY id
----
-1
0
1
2

statement ok
CREATE TABLE filtered_table (id INT)

statement ok
INSERT INTO filtered_table VALUES (-1), (0), (1), (2)

# Query should automatically filter to only id > 0
query I
SELECT * FROM filtered_table ORDER BY id
----
1
2
