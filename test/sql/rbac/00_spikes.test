# name: test/sql/rbac/00_spikes.test
# description: Validation spikes for RBAC extension hooks
# group: [rbac]

require quack

# ===== Spike 0.4: Session state =====

# Test rbac_current_user() returns default value
query I
SELECT rbac_current_user()
----
default_user

# Test rbac_is_superuser() returns true by default
query I
SELECT rbac_is_superuser()
----
true

# Test rbac_current_roles() returns empty list by default
query I
SELECT rbac_current_roles()
----
[]

# ===== Spike 0.2: Optimizer throws on blocked table =====

# Create tables for testing
statement ok
CREATE TABLE allowed (id INT)

statement ok
CREATE TABLE blocked (id INT)

# Allowed table should work fine
statement ok
SELECT * FROM allowed

# Blocked table should throw PermissionException
statement error
SELECT * FROM blocked
----
Access denied to table 'blocked'

# ===== Spike 0.3: Filter injection =====

# Unfiltered table should return all rows (no filter injected)
statement ok
CREATE TABLE unfiltered_table (id INT)

statement ok
INSERT INTO unfiltered_table VALUES (-1), (0), (1), (2)

query I
SELECT * FROM unfiltered_table ORDER BY id
----
-1
0
1
2

statement ok
CREATE TABLE filtered_table (id INT)

statement ok
INSERT INTO filtered_table VALUES (-1), (0), (1), (2)

# Query should automatically filter to only id > 0
query I
SELECT * FROM filtered_table ORDER BY id
----
1
2

# ===== Spike 0.1: Parser catches CREATE ROLE =====

# CREATE ROLE should be intercepted by our parser extension
query I
CREATE ROLE test_role
----
Role created: test_role

# DROP ROLE should also work
query I
DROP ROLE test_role
----
Role dropped: test_role

# ===== Spike 0.5: Expression binding =====

# Basic case: integer comparison with parsed expression "id > 0"
statement ok
CREATE TABLE policy_test (id INT, name VARCHAR)

statement ok
INSERT INTO policy_test VALUES (1, 'visible'), (0, 'hidden'), (2, 'also_visible')

query IT
SELECT * FROM policy_test ORDER BY id
----
1	visible
2	also_visible

# Error case: referencing non-existent column should fail
statement ok
CREATE TABLE policy_bad_column (id INT, value INT)

statement error
SELECT * FROM policy_bad_column
----
Column 'nonexistent_column' not found

# String equality filter: status = 'active'
statement ok
CREATE TABLE policy_string_filter (id INT, status VARCHAR)

statement ok
INSERT INTO policy_string_filter VALUES (1, 'active'), (2, 'inactive'), (3, 'active')

query IT
SELECT * FROM policy_string_filter ORDER BY id
----
1	active
3	active

# ===== Spike 0.6: SELECT * Column-Level Permission Feasibility =====

# Part A: Verify optimizer sees expanded columns (not SELECT *)
# The optimizer will log column_ids to stderr
statement ok
CREATE TABLE col_test (a INT, b INT, c_secret INT)

statement ok
INSERT INTO col_test VALUES (1, 2, 999), (10, 20, 888)

# This SELECT * should show optimizer sees all 3 columns
query III
SELECT * FROM col_test ORDER BY a
----
1	2	999
10	20	888

# This explicit SELECT should show optimizer sees only 2 columns
query II
SELECT a, b FROM col_test ORDER BY a
----
1	2
10	20

# Part B: Test if modifying column_ids in optimizer can filter columns
# FINDING: This DOES NOT work - removing columns from column_ids causes binding errors
# because other parts of the plan still reference the removed columns
statement ok
CREATE TABLE col_test_filter (a INT, b INT, c_secret INT)

statement ok
INSERT INTO col_test_filter VALUES (1, 2, 999), (10, 20, 888)

# Attempt to SELECT * but with c_secret filtered out by optimizer
# RESULT: Fails with "Failed to bind column reference" - downstream still expects c_secret
# statement error
# SELECT * FROM col_test_filter ORDER BY a
# ----
# Failed to bind column reference

# Part C: Test parser_override to rewrite SELECT * before binding
# Use 'fallback' mode - allows override to return DISPLAY_ORIGINAL_ERROR to fall through
statement ok
SET allow_parser_override_extension = 'fallback'

statement ok
CREATE TABLE col_test_rewrite (a INT, b INT, c_secret INT)

statement ok
INSERT INTO col_test_rewrite VALUES (1, 2, 999), (10, 20, 888)

# This SELECT * should be rewritten to SELECT a, b by parser_override
query II
SELECT * FROM col_test_rewrite ORDER BY a
----
1	2
10	20
