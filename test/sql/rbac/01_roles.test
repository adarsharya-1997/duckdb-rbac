# name: test/sql/rbac/01_roles.test
# description: Test RBAC DDL statements - roles, grants, policies
# group: [rbac]

require quack

# ===== CREATE ROLE / DROP ROLE =====

# Create a role
query I
CREATE ROLE analyst
----
Role created: analyst

# Verify role exists in system table
query I
SELECT role_name FROM duckdb_roles WHERE role_name = 'analyst'
----
analyst

# Creating same role again should fail
statement error
CREATE ROLE analyst
----
already exists

# Create another role
query I
CREATE ROLE reader
----
Role created: reader

# Drop a role
query I
DROP ROLE reader
----
Role dropped: reader

# Verify role is gone
query I
SELECT COUNT(*) FROM duckdb_roles WHERE role_name = 'reader'
----
0

# Dropping non-existent role should fail
statement error
DROP ROLE nonexistent
----
does not exist

# ===== GRANT/REVOKE ROLE MEMBERSHIP =====

# Create roles for membership test
query I
CREATE ROLE team_lead
----
Role created: team_lead

# Grant role to another role
query I
GRANT analyst TO team_lead
----
Role granted: analyst TO team_lead

# Verify membership in system table
query II
SELECT role_name, member FROM duckdb_role_members WHERE role_name = 'analyst' AND member = 'team_lead'
----
analyst	team_lead

# Grant to non-existent role should fail
statement error
GRANT analyst TO nonexistent
----
does not exist

# Revoke role membership
query I
REVOKE analyst FROM team_lead
----
Role revoked: analyst FROM team_lead

# Verify membership removed
query I
SELECT COUNT(*) FROM duckdb_role_members WHERE role_name = 'analyst' AND member = 'team_lead'
----
0

# ===== GRANT/REVOKE TABLE PRIVILEGES =====

# Create a test table
statement ok
CREATE TABLE orders (id INT, customer VARCHAR, amount DECIMAL)

# Grant SELECT on table
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# Verify grant in system table
query III
SELECT grantee, table_name, privilege_type FROM duckdb_table_privileges WHERE table_name = 'orders'
----
analyst	orders	SELECT

# Granting same privilege again should succeed (idempotent)
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# Grant to non-existent table should fail
statement error
GRANT SELECT ON nonexistent_table TO analyst
----
does not exist

# Revoke table privilege
query I
REVOKE SELECT ON orders FROM analyst
----
Table privilege revoked: SELECT ON orders FROM analyst

# Verify privilege removed
query I
SELECT COUNT(*) FROM duckdb_table_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
0

# ===== GRANT/REVOKE COLUMN PRIVILEGES =====

# Grant SELECT on specific columns
query I
GRANT SELECT (id, customer) ON orders TO analyst
----
Column privileges granted on orders TO analyst

# Verify column grants in system table
query I
SELECT COUNT(*) FROM duckdb_column_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
2

query III
SELECT grantee, column_name, privilege_type FROM duckdb_column_privileges WHERE table_name = 'orders' ORDER BY column_name
----
analyst	customer	SELECT
analyst	id	SELECT

# Grant on non-existent column should fail
statement error
GRANT SELECT (nonexistent_col) ON orders TO analyst
----
does not exist

# Revoke column privileges
query I
REVOKE SELECT (id) ON orders FROM analyst
----
Column privileges revoked on orders FROM analyst

# Verify one column privilege removed
query I
SELECT COUNT(*) FROM duckdb_column_privileges WHERE table_name = 'orders' AND grantee = 'analyst'
----
1

# ===== CREATE/DROP ROW POLICY =====

# Create a row policy
query I
CREATE ROW POLICY regional_filter ON orders FOR SELECT USING (amount > 100) TO analyst
----
Row policy created: regional_filter ON orders

# Verify policy in system table
query IIII
SELECT policy_name, table_name, filter_expression, grantee FROM duckdb_row_policies WHERE policy_name = 'regional_filter'
----
regional_filter	orders	amount > 100	analyst

# Creating same policy again should fail
statement error
CREATE ROW POLICY regional_filter ON orders FOR SELECT USING (amount > 0) TO analyst
----
already exists

# Create policy for non-existent table should fail
statement error
CREATE ROW POLICY test_policy ON nonexistent_table FOR SELECT USING (id > 0) TO analyst
----
does not exist

# Drop row policy
query I
DROP ROW POLICY regional_filter ON orders
----
Row policy dropped: regional_filter ON orders

# Verify policy removed
query I
SELECT COUNT(*) FROM duckdb_row_policies WHERE policy_name = 'regional_filter'
----
0

# ===== FR-3: Cannot drop role with existing grants =====

# Re-grant privilege to analyst
query I
GRANT SELECT ON orders TO analyst
----
Table privilege granted: SELECT ON orders TO analyst

# Trying to drop analyst should fail (has grants)
statement error
DROP ROLE analyst
----
existing grants

# Clean up grant first
query I
REVOKE SELECT ON orders FROM analyst
----
Table privilege revoked: SELECT ON orders FROM analyst

# Also clean up remaining column privilege
query I
REVOKE SELECT (customer) ON orders FROM analyst
----
Column privileges revoked on orders FROM analyst

# Now drop should succeed
query I
DROP ROLE analyst
----
Role dropped: analyst

# Clean up
query I
DROP ROLE team_lead
----
Role dropped: team_lead

statement ok
DROP TABLE orders
