# name: test/sql/rbac/identity_empty_roles_denied.test
# description: Non-superuser with empty roles is denied access
# group: [rbac]

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE secret_table (id INTEGER, note VARCHAR);

statement ok
INSERT INTO secret_table VALUES (1, 'top secret');

# =============================================================================
# Set identity with no roles and not superuser
# =============================================================================

statement ok
SELECT * FROM rbac_set_identity('empty_user', []::VARCHAR[], false);

# Should be denied without any grants
statement error
SELECT COUNT(*) FROM secret_table;
----
lacks SELECT privilege on table

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP TABLE secret_table;
