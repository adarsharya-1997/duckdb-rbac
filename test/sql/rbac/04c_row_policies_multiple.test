# name: test/sql/rbac/04c_row_policies_multiple.test
# description: Test multiple row policies combined with OR (FR-15)
# group: [rbac]

require quack

# =============================================================================
# Setup: Create table and role with multiple row policies
# =============================================================================

statement ok
CREATE TABLE orders (
    id INTEGER,
    customer VARCHAR,
    amount DECIMAL,
    region VARCHAR,
    category VARCHAR
);

statement ok
INSERT INTO orders VALUES 
    (1, 'Alice', 100.00, 'US', 'retail'),
    (2, 'Bob', 200.00, 'EU', 'wholesale'),
    (3, 'Charlie', 150.00, 'US', 'wholesale'),
    (4, 'Diana', 300.00, 'EU', 'retail'),
    (5, 'Eve', 250.00, 'APAC', 'wholesale');

statement ok
CREATE ROLE multi_policy_role;

statement ok
GRANT SELECT ON orders TO multi_policy_role;

# Create two policies for the same role - should be OR'd together
# Policy 1: See US region
statement ok
CREATE ROW POLICY us_region ON orders FOR SELECT USING (region = 'US') TO multi_policy_role;

# Policy 2: See retail category
statement ok
CREATE ROW POLICY retail_orders ON orders FOR SELECT USING (category = 'retail') TO multi_policy_role;

# =============================================================================
# Set non-superuser identity
# =============================================================================

statement ok
SELECT * FROM rbac_set_identity('multi_user', ['multi_policy_role'], false);

# =============================================================================
# Test: Multiple policies OR'd together (FR-15)
# =============================================================================

# Should see: US rows (1, 3) OR retail rows (1, 4)
# Union = rows 1, 3, 4
query I
SELECT COUNT(*) FROM orders;
----
3

query IT
SELECT id, region FROM orders ORDER BY id;
----
1	US
3	US
4	EU

# Row 1: US, retail -> visible (both policies match)
# Row 2: EU, wholesale -> not visible
# Row 3: US, wholesale -> visible (US policy)
# Row 4: EU, retail -> visible (retail policy)
# Row 5: APAC, wholesale -> not visible

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY us_region ON orders;

statement ok
DROP ROW POLICY retail_orders ON orders;

statement ok
REVOKE SELECT ON orders FROM multi_policy_role;

statement ok
DROP TABLE orders;

statement ok
DROP ROLE multi_policy_role;
