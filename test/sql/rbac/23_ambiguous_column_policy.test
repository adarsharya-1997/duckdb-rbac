# name: test/sql/rbac/23_ambiguous_column_policy.test
# description: Row policy binds unqualified columns to policy table
# group: [rbac]

require quack

# =============================================================================
# Setup
# =============================================================================

statement ok
CREATE TABLE t1 (id INTEGER, region VARCHAR);

statement ok
CREATE TABLE t2 (id INTEGER, region VARCHAR);

statement ok
INSERT INTO t1 VALUES (1, 'US');

statement ok
INSERT INTO t2 VALUES (1, 'EU');

statement ok
CREATE ROLE amb_role;

statement ok
GRANT SELECT ON t1 TO amb_role;

statement ok
GRANT SELECT ON t2 TO amb_role;

# Policy uses unqualified column name (region) bound to policy table
statement ok
CREATE ROW POLICY amb_policy ON t1 FOR SELECT USING (region = 'US') TO amb_role;

statement ok
SELECT * FROM rbac_set_identity('amb_user', ['amb_role'], false);

# =============================================================================
# Join succeeds; policy binds to t1.region
# =============================================================================

query I
SELECT COUNT(*) FROM (SELECT t1.id FROM t1 JOIN t2 ON t1.id = t2.id);
----
1

# =============================================================================
# Cleanup
# =============================================================================

statement ok
DROP ROW POLICY amb_policy ON t1;

statement ok
REVOKE SELECT ON t1 FROM amb_role;

statement ok
REVOKE SELECT ON t2 FROM amb_role;

statement ok
DROP TABLE t1;

statement ok
DROP TABLE t2;

statement ok
DROP ROLE amb_role;
