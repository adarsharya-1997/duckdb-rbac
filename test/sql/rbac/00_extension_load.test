# name: test/sql/rbac/00_extension_load.test
# description: Test RBAC extension loading and basic functions
# group: [rbac]

# Load the extension
require quack

# ===== Scalar Functions =====

# rbac_current_user() returns default user
query I
SELECT rbac_current_user()
----
default_user

# rbac_current_roles() returns empty list by default
query I
SELECT rbac_current_roles()
----
[]

# rbac_is_superuser() returns true by default
query I
SELECT rbac_is_superuser()
----
true

# ===== System Tables Exist =====

# duckdb_roles table exists and is empty
query I
SELECT COUNT(*) FROM duckdb_roles
----
0

# duckdb_role_members table exists
query I
SELECT COUNT(*) FROM duckdb_role_members
----
0

# duckdb_table_privileges table exists
query I
SELECT COUNT(*) FROM duckdb_table_privileges
----
0

# duckdb_column_privileges table exists
query I
SELECT COUNT(*) FROM duckdb_column_privileges
----
0

# duckdb_row_policies table exists
query I
SELECT COUNT(*) FROM duckdb_row_policies
----
0

# ===== rbac_set_identity() Function =====

# Set identity to a non-superuser
query I
SELECT * FROM rbac_set_identity('alice', ['analyst', 'reader'], false)
----
Identity set: user='alice', roles=['analyst', 'reader'], is_superuser=false

# Verify identity was set
query I
SELECT rbac_current_user()
----
alice

query I
SELECT rbac_current_roles()
----
[analyst, reader]

query I
SELECT rbac_is_superuser()
----
false

# Trying to set identity again should fail (immutable)
statement error
SELECT * FROM rbac_set_identity('bob', []::VARCHAR[], true)
----
RBAC identity already set

# ===== CREATE ROLE works (from spikes) =====

query I
CREATE ROLE test_role
----
Role created: test_role

query I
DROP ROLE test_role
----
Role dropped: test_role
